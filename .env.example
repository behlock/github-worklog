# GitHub Worklog - Environment Variables
# Copy this file to .env and fill in your values

# Required: Your GitHub username
GITHUB_USERNAME=your-github-username

# Required: GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=ghp_your_token_here

# Optional: Summarizer provider (default: claude)
# Options: claude, ollama
SUMMARIZER_PROVIDER=claude

# Optional: Anthropic API key for Claude summarization
# Get one at: https://console.anthropic.com/
# Required if SUMMARIZER_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Claude model to use (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Maximum tokens for Claude response (default: 500)
# CLAUDE_MAX_TOKENS=500

# Optional: Ollama settings for local LLM summarization
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: Output file path (default: ~/worklog.md)
OUTPUT_FILE=./worklog.md

# Optional: Date format for recap headers (default: %d/%m/%y)
DATE_FORMAT=%d/%m/%y
