# Copy this file to .env and fill in your values

# Required: Your GitHub creds
GITHUB_USERNAME=your-github-username

GITHUB_TOKEN=ghp_your_token_here

# Optional: Summarizer provider (default: claude)
# Options: claude, openai, gemini, ollama
SUMMARIZER_PROVIDER=claude

# Optional: Anthropic config
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: OpenAI config
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_MODEL=gpt-4.1-mini

# Optional: Gemini config
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Ollama config
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Optional: Maximum tokens for AI summary response (default: 500)
# MAX_TOKENS=500

# Optional: Output file path (default: ./worklog.md)
OUTPUT_FILE=./worklog.md

# Optional: Date format for recap headers (default: %d/%m/%y)
DATE_FORMAT=%d/%m/%y
