# Copy this file to .env and fill in your values

# Required: your GitHub credentials.
# The token needs the "repo" scope to see commits in private repositories.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_your_token_here

# Optional: summarizer provider (default: claude)
# Options: claude, openai, gemini, ollama
SUMMARIZER_PROVIDER=claude

# Optional: Anthropic config
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# CLAUDE_MODEL=claude-opus-5

# Optional: OpenAI config
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_MODEL=gpt-4.1-mini

# Optional: Gemini config
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Ollama config, free and offline (see README). Falls back to Claude
# if ANTHROPIC_API_KEY is set and Ollama fails. Pull the model with `just ollama-pull`.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b

# Optional: upper bound on the summary response (default: 4096).
# On current Claude models thinking tokens count against this, so keep it generous.
# MAX_TOKENS=4096

# Optional: output file path (default: ./worklog.md). "~" is expanded.
OUTPUT_FILE=./worklog.md

# Optional: date format for recap headers (default: %d/%m/%y).
# Must include day, month and year so entries can be recognised again later.
DATE_FORMAT=%d/%m/%y
